{
  "expo": {
    "name": "حلقتي",
    "slug": "halaqty-quran-app",
    "version": "5.10.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSFaceIDUsageDescription": "استخدم بصمة الوجه لفتح التطبيق وحماية بيانات الطلاب."
      }
    },
    "android": {
      "package": "com.halaqty.quranapp",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FDF1F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "FOREGROUND_SERVICE",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF1F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d37c28f6-0be5-421e-aeb6-6b20a289b530"
      }
    }
  }
}